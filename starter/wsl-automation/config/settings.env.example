# Settings for the wsl-automation scheduled tasks that run as Bash in WSL.
# Copy to ~/.config/wsl-automation/settings.env (or point WSL_AUTOMATION_SETTINGS
# at another file) and replace the placeholder values with your own.
#
# The file is read as data, never sourced: one KEY=VALUE per line, no quotes, no
# variable expansion (a value starting with ~/ expands to your home directory).
# A variable already set in the environment wins over this file. A key that is
# missing everywhere makes its task exit 2 with an error naming the key.

# Used by the 'Usage Census Publish' task (scripts/publish-usage-census.sh): the
# skills-evals repository it shallow-clones. The 'Session Miner' task keeps its
# own file (config/session-miner.env.example) and does not read this one.
SKILLS_EVALS_URL=https://github.com/example-adopter/skills-evals.git

# Used by the 'Memory Curation' task (scripts/run-memory-curation.sh): the
# _agent-guidance repository it shallow-clones.
AGENT_GUIDANCE_URL=https://github.com/example-adopter/_agent-guidance.git

# Used by the 'Claude Waiting Feed Publish' task (scripts/publish-waiting-feed.sh):
# the feed repository it pushes feed.json to.
WAITING_FEED_URL=https://github.com/example-adopter/waiting-feed.git

# Used by the 'Codex Cloud Environment Sync' task
# (scripts/sync-codex-cloud-environments.sh): the guidance repository as
# owner/name.
CODEX_CLOUD_GUIDANCE_REPOSITORY=example-adopter/_agent-guidance
