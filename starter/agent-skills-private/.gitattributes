# managed by _agent-guidance: hook scripts must stay LF for bash (see ADR 0019)
.claude/hooks/*.sh text eol=lf
# managed by _agent-guidance: the agent-checks runner must stay LF for bash (see ADR 0021)
.githooks/* text eol=lf
# managed by _agent-guidance: synced tooling is vendored, not this repo's code (see ADR 0048)
.githooks/** linguist-vendored
# managed by _agent-guidance: synced tooling is vendored, not this repo's code (see ADR 0048)
.claude/hooks/** linguist-vendored
# Plugin hook scripts run under bash, which fails on CRLF; keep them LF on every checkout.
plugins/*/hooks/**/*.sh text eol=lf
# This repo's own agent checks run under bash too.
.agent-checks/* text eol=lf
