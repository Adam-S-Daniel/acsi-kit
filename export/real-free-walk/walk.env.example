# walk.env: the real walk's settings, read by walk.sh (REAL_WALK_ENV names it).
# Keep it outside the kit and outside any repo: it names the test account.
# No secret goes here; gh keeps its token under WALK_DIR/home.

# Absolute path of the walk's own folder. Not inside any git repo. walk.sh
# uses WALK_DIR/home as HOME; the kit clone and fleet.env sit beside it.
WALK_DIR=/path/to/acsi-free-walk
# The Free test account's login, and its numeric id
# (https://api.github.com/users/<login>, field "id"). They make the commit
# identity <id>+<login> at GitHub's noreply domain.
TEST_LOGIN=example-free-walk
TEST_USER_ID=0
