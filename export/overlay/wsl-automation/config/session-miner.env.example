# session-miner.env: settings for scripts/run-session-miner.sh. Copy it to
# ~/.config/wsl-automation/session-miner.env (or point SESSION_MINER_CONFIG at
# it) and edit. A scheduled run has no environment of its own, so this file is
# where its settings go. It is read as data, never sourced: one KEY=value per
# line, blank lines and # comments skipped, a leading ~/ expanded, and a
# variable already in the environment wins.

# Required: the private registry clone whose origin receives the lesson
# records (persistent/lessons). Unset, the wrapper exits 2 naming it.
LESSONS_CLONE=~/repos/acsi-agentskills-private

# Required: the skills-evals repository whose main the wrapper clones and runs
# the miner from. Unset, the wrapper exits 2 naming it.
SKILLS_EVALS_URL=https://github.com/example-adopter/skills-evals.git

# Optional: the privacy denylist, kept outside every repository
# (default ~/.config/privacy-denylist.txt).
#PRIVACY_DENYLIST_FILE=~/.config/privacy-denylist.txt

# Optional, in WSL: the Windows profile as a WSL path, which adds the Windows
# transcripts.
#WIN_HOME=/mnt/c/Users/<you>

# Optional: on allows --file-issues, after you have rated a sample of records.
#FILE_ISSUES=on
